{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WindowShot",
  "version": "0.1.0",
  "identifier": "io.github.taylorivanoff.window-shot",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "WindowShot",
        "url": "index.html",
        "width": 920,
        "height": 640,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "maximizable": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_MINISIGN_PUBLIC_KEY",
      "endpoints": []
    }
  }
}
